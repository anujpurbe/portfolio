# GitHub — used for the coding activity section
NEXT_PUBLIC_GITHUB_USERNAME=anujpurbe

# Optional: enables the contribution heatmap (GraphQL). Needs a fine-grained
# PAT with public read access. Without it, stats + repos still show; the
# heatmap shows an honest "unavailable" state.
GITHUB_TOKEN=

# Contact form via EmailJS (https://www.emailjs.com)
# Server-side only — never exposed to the browser.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
