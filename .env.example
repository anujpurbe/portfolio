# GitHub — used for the coding activity section
NEXT_PUBLIC_GITHUB_USERNAME=anujpurbe

# ask://anuj — the AI portfolio assistant in the hero.
#
# Optional. Without a key the assistant still works, powered by a
# deterministic local engine grounded in the real portfolio data files.
# With a key it answers through an OpenAI-compatible chat completions API
# (server-side only; the key is never exposed to the browser).
#
# Default provider is Google Gemini via its official OpenAI-compatible
# endpoint. Get a key from Google AI Studio (https://aistudio.google.com).
# Any other OpenAI-compatible provider works by overriding AI_BASE_URL and
# AI_MODEL.
#
# AI_API_KEY=
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_MODEL=gemini-3.6-flash
# AI_TIMEOUT_MS=15000

# Optional: enables the contribution heatmap (GraphQL). Needs a fine-grained
# PAT with public read access. Without it, stats + repos still show; the
# heatmap shows an honest "unavailable" state.
GITHUB_TOKEN=

# LeetCode — public profile used for the coding performance section.
# When empty, the section shows an honest "unavailable" state.
NEXT_PUBLIC_LEETCODE_USERNAME=

# Contact form.
#
# Either channel below is enough for the form to work. If both are set, the
# message is BOTH emailed (EmailJS) and stored (Supabase).

# EmailJS (https://www.emailjs.com) — server-side only, never exposed.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=

# Supabase storage (https://supabase.com) — server-side only, never exposed
# to the browser. Uses the current key system: sb_publishable_ (client) and
# sb_secret_ (server). The server routes use the SECRET key only.
# Requires tables:
#   `contact_messages`: id uuid pk default gen_random_uuid(), name text,
#     email text, subject text, message text, status text default 'new',
#     ip text, user_agent text, created_at timestamptz default now().
#   `comments`: id uuid pk default gen_random_uuid(), name text, comment text,
#     status text default 'pending', ip text,
#     created_at timestamptz default now().
# Both tables must have RLS enabled (see supabase/migrations for the full
# schema + policies). Comments are read publicly only when approved.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Admin panel (https://<site>/admin) for contact messages + comment
# moderation. Optional — the panel shows a setup note without them.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Rate limiting (Upstash Redis, https://upstash.com).
#
# Optional but recommended: without these the in-memory limiter is used, which
# on serverless (Vercel) is per-instance and only a best-effort guard against
# casual abuse. With a Redis database, limits are enforced globally across all
# instances. Grab a REST URL + token from your Upstash database settings.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
