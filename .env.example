# GitHub — used for the coding activity section
NEXT_PUBLIC_GITHUB_USERNAME=anujpurbe

# ask://anuj — the AI portfolio assistant in the hero.
#
# Optional. Without a key the assistant still works, powered by a
# deterministic local engine grounded in the real portfolio data files.
# With a key it answers through an OpenAI-compatible chat completions API
# (server-side only; the key is never exposed to the browser).
#
# Any OpenAI-compatible provider works, e.g.:
#   OpenAI:      AI_BASE_URL=https://api.openai.com/v1      AI_MODEL=gpt-4o-mini
#   Google:      AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                AI_MODEL=gemini-2.0-flash  (key from Google AI Studio)
#
# AI_API_KEY=your-openai-compatible-api-key
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_TIMEOUT_MS=15000

# Optional: enables the contribution heatmap (GraphQL). Needs a fine-grained
# PAT with public read access. Without it, stats + repos still show; the
# heatmap shows an honest "unavailable" state.
GITHUB_TOKEN=

# LeetCode — public profile used for the coding performance section.
# When empty, the section shows an honest "unavailable" state.
NEXT_PUBLIC_LEETCODE_USERNAME=

# Contact form.
#
# Either channel below is enough for the form to work. If both are set, the
# message is BOTH emailed (EmailJS) and stored (Supabase).

# EmailJS (https://www.emailjs.com) — server-side only, never exposed.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=

# Supabase storage (https://supabase.com) — server-side only.
# Requires tables:
#   `messages`: id uuid pk default gen_random_uuid(), name text, email text,
#     subject text, message text, status text default 'new', ip text,
#     user_agent text, created_at timestamptz default now().
#   `comments`: id uuid pk default gen_random_uuid(), name text, comment text,
#     status text default 'pending', ip text,
#     created_at timestamptz default now().
# Enable RLS with a "service role" policy, or use permissive policies.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel (https://<site>/admin) for contact messages + comment
# moderation. Optional — the panel shows a setup note without them.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
